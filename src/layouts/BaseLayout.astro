---

import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  bodyClass?: 'site-home' | 'site-page';
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  bodyClass = 'site-page',
  ogType = 'website',
  structuredData,
} = Astro.props;

const site = 'https://naabil.com';
const canonical = new URL(Astro.url.pathname, Astro.url.origin).toString();
const ogImage = new URL('/og-image.jpg', Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Nabil Malki, Naabil, Naabil Malki, backend developer, backend engineer, software engineer, TypeScript, Node.js, Go, Hono, API development, infrastructure, Dynamick" />
    <meta name="author" content="Nabil Malki (Naabil)" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#f4f1ea" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/ico+xml" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Naabil" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Nabil Malki',
	alternateName: 'Naabil',
	url: site,
	jobTitle: 'Backend Developer',
	knowsAbout: ['TypeScript', 'Node.js', 'Go', 'Hono', 'Backend Engineering', 'Infrastructure'],
	sameAs: [
	'https://www.dynamick.dev',
	'https://github.com/malki-nabil',
	'https://x.com/NaabilMalki',
	'https://ko-fi.com/naabil',
	],
	})} />
    {
      structuredData && (
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )
    }
  </head>
  <body class={bodyClass}>
    <Analytics />
    <SpeedInsights />
    <slot />
  </body>
</html>
