---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Blog — Naabil';
const description = 'Notes and writing from Naabil about backend development, APIs and infrastructure.';

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title={title} description={description} bodyClass="site-page">
  <main>
    <p class="eyebrow">blog</p>
    <h1>Blog</h1>
    <p class="role">Notes on backend development, APIs and infrastructure.</p>

    <hr>

    {
      posts.length === 0 ? (
        <p class="empty">No posts yet. Check back soon.</p>
      ) : (
        <ul class="post-list">
          {
            posts.map((post) => (
              <li>
                <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
                <p class="post-meta">{formatDate(post.data.pubDate)}</p>
                <p class="post-desc">{post.data.description}</p>
              </li>
            ))
          }
        </ul>
      )
    }

    <nav aria-label="Site links">
      <a href="/">Home</a>
      <a href="https://codeberg.org/Naabil" target="_blank" rel="noopener">Codeberg</a>
      <a href="https://x.com/NaabilMalki" target="_blank" rel="noopener">X / Twitter</a>
      <a href="https://ko-fi.com/naabil" target="_blank" rel="noopener">Ko-fi</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .empty {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 14px 0 18px;
    border-bottom: 1px solid var(--line);
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-title {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    border-bottom: 2px solid var(--red);
  }

  .post-title:hover {
    color: var(--red);
  }

  .post-meta {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 8px 0 6px;
  }

  .post-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
