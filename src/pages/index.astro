---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Naabil — Backend Developer';
const description = 'Naabil is a backend developer building systems, APIs & infrastructure with TypeScript, Node.js, Go and Hono. Currently building HonoForge.';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts[0];
---

<BaseLayout title={title} description={description} bodyClass="site-home">
  <main>
    <p class="eyebrow">whoami</p>
    <h1>Naabil</h1>
    <p class="role">Backend developer building systems, APIs &amp; infrastructure.</p>
    <p class="stack">TypeScript<span>·</span>Node.js<span>·</span>Go<span>·</span>Hono</p>

    <hr>

    <p class="focus-label">Currently building</p>
    <div class="focus">
      <a href="https://honoforge.naabil.com" target="_blank" rel="noopener">HonoForge →</a>
      <p>A Hono-based project exploring backend tooling and infrastructure patterns. Open source, in active development.</p>
    </div>

    {
      latest && (
        <>
          <hr>

          <p class="focus-label">Latest post</p>
          <div class="focus">
            <a href={`/blog/${latest.id}/`}>{latest.data.title} →</a>
            <p>{latest.data.description}</p>
          </div>
        </>
      )
    }

    <nav aria-label="Site links">
      <a href="/blog/">Blog</a>
      <a href="https://codeberg.org/Naabil" target="_blank" rel="noopener">Codeberg</a>
      <a href="https://x.com/NaabilMalki" target="_blank" rel="noopener">X / Twitter</a>
      <a href="https://ko-fi.com/naabil" target="_blank" rel="noopener">Ko-fi</a>
    </nav>
  </main>
</BaseLayout>
